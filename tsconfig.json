{
  "compileOnSave": false,
  "compilerOptions": {
    "baseUrl": "./",
    "outDir": "./dist/out-tsc",
    "sourceMap": true,
    "declaration": false,
    "esModuleInterop": true,
    "ignoreDeprecations": "6.0",
    "strict": false,
    "noImplicitAny": false,
    "strictPropertyInitialization": false,
    "module": "ES2022",
    "moduleResolution": "bundler",
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "ES2022",
    "useDefineForClassFields": false,
    "skipLibCheck": true,
    "typeRoots": [
      "node_modules/@types"
    ],
    "lib": [
      "ES2022",
      "dom"
    ],
    "paths": {
      "Generic-CRUD": [
        "dist/generic-crud"
      ],
      "Generic-CRUD/*": [
        "dist/generic-crud/*"
      ],
      "generic-crud-bootstrap": [
        "dist/generic-crud-bootstrap"
      ],
      "generic-crud-ionic": [
        "dist/generic-crud-ionic"
      ]
    }
  }
}
