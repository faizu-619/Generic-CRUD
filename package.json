{
  "name": "generic-crud-example",
  "version": "1.0.0",
  "scripts": {
    "ng": "ng",
    "start": "concurrently \"npm:api\" \"npm:start:app\"",
    "start:app": "ng serve",
    "build": "ng build --configuration production",
    "build:Generic-CRUD": "ng build Generic-CRUD --configuration production",
    "build:generic-crud-bootstrap": "ng build generic-crud-bootstrap --configuration production",
    "build:generic-crud-ionic": "ng build generic-crud-ionic --configuration production",
    "publish:Generic-CRUD": "npm run build:Generic-CRUD && cd dist/generic-crud && npm publish",
    "publish:generic-crud-bootstrap": "npm run build:generic-crud-bootstrap && cd dist/generic-crud-bootstrap && npm publish",
    "publish:generic-crud-ionic": "npm run build:generic-crud-ionic && cd dist/generic-crud-ionic && npm publish",
    "publish:all": "npm run publish:Generic-CRUD && npm run publish:generic-crud-bootstrap && npm run publish:generic-crud-ionic",
    "test:Generic-CRUD": "ng test Generic-CRUD",
    "test": "ng test",
    "lint": "eslint . --ext .ts,.html",
    "lint:fix": "eslint . --ext .ts,.html --fix",
    "api": "json-server api/db.json --routes api/routes.json"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "^22.1.2",
    "@angular/common": "^22.1.2",
    "@angular/compiler": "^22.1.2",
    "@angular/core": "^22.1.2",
    "@angular/forms": "^22.1.2",
    "@angular/platform-browser": "^22.1.2",
    "@angular/platform-browser-dynamic": "^22.1.2",
    "@angular/router": "^22.1.2",
    "@ionic/angular": "^8.8.18",
    "bootstrap": "^5.3.8",
    "core-js": "^3.25.5",
    "jquery": "^3.6.1",
    "moment": "^2.29.4",
    "ngx-colors": "^2.10.2",
    "ngx-daterangepicker-material": "^2.4.2",
    "ngx-mask": "^22.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.1.0",
    "@angular-eslint/eslint-plugin": "^22.1.0",
    "@angular-eslint/eslint-plugin-template": "^22.1.0",
    "@angular-eslint/schematics": "^22.1.0",
    "@angular-eslint/template-parser": "^22.1.0",
    "@angular/build": "^22.1.4",
    "@angular/cli": "^22.1.4",
    "@angular/compiler-cli": "^22.1.2",
    "@angular/language-service": "^22.1.2",
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^18.18.0",
    "@typescript-eslint/eslint-plugin": "^8.67.0",
    "@typescript-eslint/parser": "^8.67.0",
    "concurrently": "^9.0.1",
    "eslint": "^10.8.1",
    "istanbul-lib-instrument": "^6.0.3",
    "jasmine-core": "~5.1.0",
    "jasmine-spec-reporter": "~7.0.0",
    "json-server": "^0.16.3",
    "karma": "~6.4.1",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.0",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.1.0",
    "ng-packagr": "^22.1.1",
    "rollup-plugin-node-polyfills": "^0.2.1",
    "ts-node": "^9.1.1",
    "tslib": "^2.3.1",
    "typescript": "~6.0.3",
    "webpack": "^5.107.2"
  }
}
